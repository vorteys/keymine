# Copie ce fichier vers .env et ajuste au besoin.

# Postgres. En dev, `bun run db:dev` démarre un vrai Postgres local sur ces
# identifiants (binaire embarqué, aucune installation système requise).
DATABASE_URL="postgresql://keymine:keymine@127.0.0.1:54329/keymine"

# Secret utilisé pour signer les cookies de session (JWT). Génère le tien avec:
#   openssl rand -base64 32
SESSION_SECRET="change-me-en-production"

# OAuth Discord — optionnel (AUTH-5). Laisse vide pour désactiver le bouton.
# Callback à enregistrer côté Discord: {NEXT_PUBLIC_SITE_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# OAuth GitHub — optionnel (AUTH-5). Laisse vide pour désactiver le bouton.
# Callback à enregistrer côté GitHub: {NEXT_PUBLIC_SITE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# URL publique du site (callbacks OAuth, liens absolus).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Serveur temps réel WebSocket (voir realtime/server.ts).
REALTIME_PORT=4001
NEXT_PUBLIC_REALTIME_URL="ws://localhost:4001"
