# Copie ce fichier en deploy/.env.prod et remplis les valeurs. Ne le commite jamais.
DOMAIN=keymine.exemple.com
POSTGRES_PASSWORD=change-moi
# openssl rand -base64 32
SESSION_SECRET=change-moi
# Optionnel : connexion Discord / GitHub (laisser vide pour désactiver)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# false : ne crée pas les comptes de démonstration (alice, bruno…) sur le serveur
SEED_DEMO_USERS=true
